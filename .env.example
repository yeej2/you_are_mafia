# Server only. Never prefix the key with NEXT_PUBLIC_ or include it in a mobile bundle.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_VOICE_MODEL=gpt-4o-mini-tts
# Mobile bundle only: the HTTPS origin of the deployed game server, no trailing slash.
NEXT_PUBLIC_GAME_API_URL=
